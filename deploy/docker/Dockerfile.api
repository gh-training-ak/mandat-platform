FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

COPY Directory.Build.props ./
COPY src/Mandat.Domain/Mandat.Domain.csproj src/Mandat.Domain/
COPY src/Mandat.Application/Mandat.Application.csproj src/Mandat.Application/
COPY src/Mandat.Infrastructure/Mandat.Infrastructure.csproj src/Mandat.Infrastructure/
COPY src/Mandat.Api/Mandat.Api.csproj src/Mandat.Api/
RUN dotnet restore src/Mandat.Api/Mandat.Api.csproj

COPY . .
RUN dotnet publish src/Mandat.Api/Mandat.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS runtime
WORKDIR /app
RUN adduser --disabled-password --no-create-home --uid 10001 mandat
USER 10001
COPY --from=build /app .
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://localhost:8080/healthz || exit 1
ENTRYPOINT ["dotnet", "Mandat.Api.dll"]
